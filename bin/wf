#!/bin/zsh
# wf: manage the Alfred workflows in this repo and their links into Alfred.
# Run `wf help` for usage.

emulate -L zsh
setopt err_return pipe_fail no_unset

REPO=${0:A:h:h}
# Tiers, highest first. A workflow moves up one tier at a time with `wf promote`.
AREAS=(gallery release wip)
PLIST_TOOL=(python3 -I "$REPO/bin/lib/plisttool.py")

die()  { print -u2 -r -- "wf: $*"; exit 1 }
info() { print -r -- "$*" }

# Alfred's workflows directory: $ALFRED_WORKFLOWS_DIR if set, else the synced
# preferences folder if one is configured, else the default location.
alfred_dir() {
  if [[ -n ${ALFRED_WORKFLOWS_DIR:-} ]]; then
    print -r -- $ALFRED_WORKFLOWS_DIR
    return
  fi
  local sync
  sync=$(defaults read com.runningwithcrayons.Alfred-Preferences syncfolder 2>/dev/null) || sync=
  if [[ -n $sync ]]; then
    print -r -- "${sync/#\~/$HOME}/Alfred.alfredpreferences/workflows"
  else
    print -r -- "$HOME/Library/Application Support/Alfred/Alfred.alfredpreferences/workflows"
  fi
}

plist_get() { plutil -extract $2 raw -o - $1 2>/dev/null || true }

# Path of a workflow in the repo, by slug.
wf_path() {
  local slug=$1 area
  for area in $AREAS; do
    [[ -f $REPO/$area/$slug/info.plist ]] && { print -r -- $REPO/$area/$slug; return }
  done
  die "no workflow '$slug' in ${(j:/ or :)AREAS}/"
}

# Sets $reply to the symlinks in Alfred's directory that resolve to $1.
links_to() {
  local target=${1:A} l
  reply=()
  for l in $(alfred_dir)/*(N@); do
    [[ ${l:A} == $target ]] && reply+=($l)
  done
  return 0
}

cmd_status() {
  local ad=$(alfred_dir) area d l linked
  local fmt='%-10s %-20s %-26s %-9s %s\n'
  info "Alfred workflows dir: $ad"
  info
  printf $fmt AREA SLUG NAME VERSION LINKED
  for area in $AREAS; do
    for d in $REPO/$area/*(N/); do
      [[ -f $d/info.plist ]] || continue
      links_to $d
      if (( $#reply )); then linked=yes; else linked=no; fi
      printf $fmt $area ${d:t} "$(plist_get $d/info.plist name)" \
        "${$(plist_get $d/info.plist version):--}" $linked
    done
  done
  for l in $ad/*(N@); do
    if [[ $(readlink $l) == $REPO/* && ! -e $l ]]; then
      info
      info "Broken link: ${l:t} -> $(readlink $l)"
    fi
  done
}

cmd_link() {
  (( $# == 1 )) || die "usage: wf link <slug>"
  local slug=$1 d ad bid other dest
  d=$(wf_path $slug)
  ad=$(alfred_dir)
  links_to $d
  (( $#reply )) && { info "$slug is already linked: ${reply[1]:t}"; return }
  bid=$(plist_get $d/info.plist bundleid)
  if [[ -n $bid ]]; then
    for other in $ad/*(N/); do
      [[ $(plist_get $other/info.plist bundleid) == $bid ]] &&
        die "Alfred already has a workflow with bundle ID $bid (${other:t}). Remove it first, or use 'wf adopt'."
    done
  fi
  dest=$ad/user.workflow.$slug
  [[ -e $dest || -L $dest ]] && die "$dest already exists"
  ln -s $d $dest
  info "Linked $slug -> ${dest:t}"
}

cmd_unlink() {
  (( $# == 1 )) || die "usage: wf unlink <slug>"
  local d l
  d=$(wf_path $1)
  links_to $d
  (( $#reply )) || { info "$1 is not linked"; return }
  for l in $reply; do rm $l; info "Removed link ${l:t}"; done
}

# Move a workflow out of Alfred's directory into wip/<slug>, leaving a symlink
# in its place so Alfred keeps loading it.
cmd_adopt() {
  (( $# == 2 )) || die "usage: wf adopt <workflow name or Alfred folder> <slug>"
  local query=$1 slug=$2 ad src dest d
  local -a matches
  ad=$(alfred_dir)
  [[ $slug =~ '^[a-z0-9][a-z0-9-]*$' ]] || die "slug must be lowercase letters, digits and hyphens"
  if [[ -d $ad/$query ]]; then
    matches=($ad/$query)
  else
    for d in $ad/*(N/); do
      [[ ${(L)$(plist_get $d/info.plist name)} == ${(L)query} ]] && matches+=($d)
    done
  fi
  (( $#matches == 1 )) || die "expected one workflow matching '$query', found $#matches"
  src=$matches[1]
  [[ -L $src ]] && die "${src:t} is already a symlink (to $(readlink $src))"
  for d in $AREAS; do [[ -e $REPO/$d/$slug ]] && die "$d/$slug already exists"; done
  dest=$REPO/wip/$slug
  mkdir -p $REPO/wip
  mv $src $dest
  ln -s $dest $src
  info "Adopted '$(plist_get $dest/info.plist name)' into wip/$slug (Alfred folder ${src:t} is now a link)"
}

# Move a workflow up one tier (wip -> release -> gallery) and repoint its links.
# Leaving wip requires a tagged release of the current version.
cmd_promote() {
  (( $# == 1 )) || die "usage: wf promote <slug>"
  local slug=$1 src from to dest ver l
  local -a links
  src=$(wf_path $slug)
  from=${src:h:t}
  case $from in
    wip)     to=release ;;
    release) to=gallery ;;
    *)       die "$slug is already in gallery/" ;;
  esac
  if [[ $from == wip ]]; then
    ver=$(plist_get $src/info.plist version)
    [[ -n $ver ]] && git -C $REPO rev-parse -q --verify refs/tags/$slug/v$ver >/dev/null ||
      die "$slug has no tagged release yet; run 'wf release $slug <version>' first"
  fi
  dest=$REPO/$to/$slug
  [[ -e $dest ]] && die "$to/$slug already exists"
  links_to $src; links=($reply)
  mkdir -p $REPO/$to
  if [[ -n $(git -C $REPO ls-files -- $from/$slug) ]]; then
    git -C $REPO mv $from/$slug $to/$slug
  else
    mv $src $dest
  fi
  for l in $links; do rm $l; ln -s $dest $l; done
  info "Promoted $slug from $from/ to $to/ (${#links} link(s) updated)"
}

# Files that ship: everything git tracks or would track in the workflow folder
# (so .gitignore rules apply), minus the developer-notes README.md and patterns
# listed in the workflow's .wfignore. A pattern matches a path or anything
# under it; a trailing slash, as in .gitignore, is allowed and dropped.
ship_files() {
  local d=$1 f pat
  local -a ignore
  [[ -f $d/.wfignore ]] && ignore=(${(f)"$(grep -v -E '^\s*(#|$)' $d/.wfignore)"})
  ignore=(${ignore%/})
  ignore+=(.wfignore README.md)
  git -C $d ls-files -z --cached --others --exclude-standard -- . | while IFS= read -r -d '' f; do
    [[ -e $d/$f ]] || continue
    for pat in $ignore; do
      [[ $f == ${~pat} || $f == ${~pat}/* ]] && continue 2
    done
    print -r -- $f
  done
}

# Warn when the workflow differs from what was tagged as <slug>/v<version>, so a
# build is never mistaken for the released version. The tagged copy may be in
# either area, since promote moves workflows after release.
warn_if_not_release() {
  local slug=$1 d=$2 ver=$3 tag=$1/v$3 rel=${2#$REPO/} area tagged=
  if ! git -C $REPO rev-parse -q --verify refs/tags/$tag >/dev/null; then
    info "Warning: there is no $tag tag, so this build is not a tagged release"
    return 0
  fi
  for area in $AREAS; do
    git -C $REPO rev-parse -q --verify "$tag:$area/$slug" >/dev/null && tagged=$area/$slug
  done
  if [[ -n $(git -C $REPO status --porcelain -- $rel) ]] ||
     ! git -C $REPO diff --quiet "$tag:$tagged" "HEAD:$rel" 2>/dev/null; then
    info "Warning: $slug has changed since $tag, so this build is not the released v$ver"
  fi
  return 0
}

# Sets $reply to the shipped compiled (Mach-O) binaries that aren't signed with
# a Developer ID and notarised. Gatekeeper refuses to load those from a
# downloaded, quarantined copy, and the Alfred Gallery requires notarisation.
# A framework or bare binary can't have its ticket stapled, so spctl looks it
# up online and the check needs a network connection.
unnotarised_binaries() {
  local d=$1 f out
  reply=()
  ship_files $d | while IFS= read -r f; do
    [[ -f $d/$f && ! -L $d/$f ]] || continue
    [[ $(file -b $d/$f) == Mach-O* ]] || continue
    out=$(spctl --assess -vv --type open --context context:primary-signature $d/$f 2>&1) || true
    [[ $out == *'source=Notarized Developer ID'* ]] || reply+=($f)
  done
  return 0
}

# Fails, or with $2 = warn only warns, when a shipped binary isn't notarised.
check_notarised() {
  local d=$1 mode=${2:-fail} f
  unnotarised_binaries $d
  (( $#reply )) || return 0
  if [[ $mode == warn ]]; then
    info "Warning: unsigned build, don't release it. These binaries aren't Developer ID signed and notarised:"
  else
    print -u2 -r -- "wf: these binaries aren't Developer ID signed and notarised, so Gatekeeper blocks them on other Macs:"
  fi
  for f in $reply; do print -u2 -r -- "  ${d#$REPO/}/$f"; done
  [[ $mode == warn ]] && return 0
  print -u2 -r -- "wf: sign and notarise them (check with: spctl -a -vv -t open --context context:primary-signature <binary>)."
  print -u2 -r -- "wf: For a local test build only: wf build --allow-unsigned ${d:t}"
  exit 1
}

cmd_build() {
  local allow_unsigned=0
  [[ ${1:-} == --allow-unsigned ]] && { allow_unsigned=1; shift }
  (( $# == 1 )) || die "usage: wf build [--allow-unsigned] <slug>"
  local slug=$1 d ver stage out f
  d=$(wf_path $slug)
  ver=$(plist_get $d/info.plist version)
  [[ -n $ver ]] || die "$slug has no version set (use 'wf release $slug <version>')"
  if (( allow_unsigned )); then
    check_notarised $d warn
  else
    check_notarised $d
  fi
  warn_if_not_release $slug $d $ver
  stage=$(mktemp -d)
  trap "rm -rf ${(q)stage}" EXIT
  ship_files $d | while IFS= read -r f; do
    mkdir -p $stage/${f:h}
    cp -pP $d/$f $stage/$f
  done
  [[ -f $stage/info.plist ]] || die "info.plist is not part of the build (is it gitignored?)"
  $PLIST_TOOL strip $stage/info.plist
  mkdir -p $REPO/dist
  out=$REPO/dist/$slug-$ver.alfredworkflow
  rm -f $out
  (cd $stage && zip -q -r -X -y $out .)
  info "Built dist/${out:t}"
}

# Push a release tag to origin. A failed push leaves the local release intact,
# so it only warns.
push_tag() {
  local tag=$1
  if ! git -C $REPO remote get-url origin >/dev/null 2>&1; then
    info "No 'origin' remote; tag $tag not pushed"
    return 0
  fi
  if git -C $REPO push -q origin refs/tags/$tag; then
    info "Pushed tag $tag to origin"
  else
    info "Warning: could not push tag $tag; retry with: git push origin $tag"
  fi
  return 0
}

# Create a draft GitHub release for <slug>/v<version> with the build attached,
# and open its edit page in the browser to review and publish it. A draft isn't
# public until published. The notes list the commits touching the workflow (in
# any tier) since its previous release tag. --verify-tag stops gh creating the
# tag itself when the push failed. --latest=false because "Latest" is repo-wide,
# which means little with several workflows in one repo.
draft_github_release() {
  local slug=$1 d=$2 ver=$3 unsigned=${4:-0} tag=$1/v$3 out=$REPO/dist/$1-$3.alfredworkflow
  local name prev notes url changes
  local -a flags
  if ! command -v gh >/dev/null; then
    info "gh isn't installed, so there is no GitHub release; create one for $tag by hand"
    return 0
  fi
  name=$(plist_get $d/info.plist name)
  prev=$(git -C $REPO describe --tags --abbrev=0 --match "$slug/v*" "$tag^" 2>/dev/null) || prev=
  notes=$(mktemp)
  if [[ -n $prev ]]; then
    changes=$(git -C $REPO log --format='- %s' $prev..$tag -- {wip,release,gallery}/$slug |
      grep -v -F -- "$slug: release v") || true
    print -r -- "Changes since ${prev#$slug/}:"$'\n\n'"${changes:-- (no commits besides the version change)}" > $notes
  else
    print -r -- "First release." > $notes
  fi
  if (( unsigned )); then
    print -r -- $'**Unsigned preview.** Its compiled binaries aren\'t notarised, so macOS may block them on a Mac that downloaded it.\n' |
      cat - $notes > $notes.new && mv $notes.new $notes
  fi
  flags=(--draft --verify-tag --latest=false --title "$name $ver" --notes-file $notes)
  [[ $ver == *-* ]] && flags+=(--prerelease)
  if ! url=$(cd $REPO && gh release create $tag $out $flags); then
    rm -f $notes
    info "Warning: could not create a GitHub release for $tag; retry with: gh release create $tag dist/${out:t} --draft --verify-tag --latest=false"
    return 0
  fi
  rm -f $notes
  url=${url/\/releases\/tag\//\/releases\/edit\/}
  info "Draft GitHub release created; review and publish it at $url"
  open $url
  return 0
}

# --allow-unsigned is only accepted for pre-release versions (1.2.3-preview.1),
# so an unnotarised build can't become a normal release by mistake.
cmd_release() {
  local allow_unsigned=0
  [[ ${1:-} == --allow-unsigned ]] && { allow_unsigned=1; shift }
  (( $# == 2 )) || die "usage: wf release [--allow-unsigned] <slug> <version>"
  local slug=$1 ver=$2 d rel tag
  d=$(wf_path $slug)
  rel=${d#$REPO/}
  [[ $ver =~ '^[0-9]+(\.[0-9]+){1,2}(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?$' ]] ||
    die "version must look like 1.2, 1.2.3 or 1.2.3-beta.1"
  (( allow_unsigned )) && [[ $ver != *-* ]] &&
    die "--allow-unsigned is only for pre-release versions, such as $ver-preview.1"
  tag=$slug/v$ver
  git -C $REPO rev-parse -q --verify refs/tags/$tag >/dev/null && die "tag $tag already exists"
  [[ -z $(git -C $REPO status --porcelain -- $rel) ]] ||
    die "$rel has uncommitted changes; commit them first so the release matches the repo"
  # Before anything is committed or tagged, so a failure leaves no half-release.
  # With --allow-unsigned the build step gives the warning.
  (( allow_unsigned )) || check_notarised $d
  plutil -replace version -string $ver $d/info.plist
  if [[ -n $(git -C $REPO status --porcelain -- $rel/info.plist) ]]; then
    git -C $REPO add -- $rel/info.plist
    git -C $REPO commit -q -m "$slug: release v$ver" -- $rel/info.plist
  fi
  git -C $REPO tag -a $tag -m "$slug v$ver"
  if (( allow_unsigned )); then
    cmd_build --allow-unsigned $slug
  else
    cmd_build $slug
  fi
  info "Tagged $tag; built dist/$slug-$ver.alfredworkflow"
  push_tag $tag
  draft_github_release $slug $d $ver $allow_unsigned
  [[ $rel == wip/* && $ver != *-* ]] && info "Once it is posted on the forum, run: wf promote $slug"
  return 0
}

cmd_setup() {
  git -C $REPO config core.hooksPath .githooks
  info "Git hooks enabled (core.hooksPath = .githooks)"
}

cmd_help() {
  cat <<'EOF'
Usage: wf <command> [args]

  status                      List workflows, versions and whether Alfred has them linked
  adopt <name|folder> <slug>  Move a workflow made in Alfred into wip/<slug> and link it back
  link <slug>                 Symlink a repo workflow into Alfred
  unlink <slug>               Remove a workflow's symlink from Alfred (repo copy is untouched)
  promote <slug>              Move a workflow up a tier (wip -> release -> gallery) and repoint its link
  build [--allow-unsigned] <slug>
                              Build dist/<slug>-<version>.alfredworkflow at the current version;
                              fails if a compiled binary isn't notarised, unless --allow-unsigned
  release [--allow-unsigned] <slug> <version>
                              Set the version, commit, tag <slug>/v<version>, build, and open a
                              draft GitHub release with the build attached; --allow-unsigned
                              only for pre-release versions (1.2.3-preview.1)
  setup                       Enable the repo's git hooks (run once per clone)

Set ALFRED_WORKFLOWS_DIR to point at a different Alfred workflows directory.
EOF
}

(( $# )) || { cmd_help; exit 0 }
cmd=$1; shift
(( $+functions[cmd_$cmd] )) || die "unknown command '$cmd' (see 'wf help')"
cmd_$cmd "$@"
