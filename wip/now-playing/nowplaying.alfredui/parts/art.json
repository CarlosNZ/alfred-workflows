{
  "type": "view",
  "layout": "stack",
  "components": [
    {
      "id": "art",
      "type": "imageview",
      "resize": "fit",
      "cornerradius": 10,
      "image": { "type": "symbol", "src": "music.note", "size": { "width": 96 } },
      "constraints": { "stretch": "both" }
    },
    {
      "id": "idleart",
      "type": "view",
      "layout": "stack",
      "hidden": true,
      "constraints": { "position": "centre" },
      "components": [
        {
          "id": "idleartimage",
          "type": "imageview",
          "resize": "fit",
          "image": { "type": "symbol", "src": "music.note" },
          "constraints": { "stretch": "both" }
        }
      ]
    }
  ]
}
