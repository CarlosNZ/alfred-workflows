{
  "type": "view",
  "layout": "stack",
  "components": [
    {
      "id": "art",
      "type": "imageview",
      "resize": "fit",
      "cornerradius": 10,
      "image": { "type": "symbol", "src": "music.note", "size": { "width": 96 } },
      "constraints": { "stretch": "both" }
    },
    {
      "id": "defaultapp",
      "type": "view",
      "layout": "stack",
      "hidden": true,
      "constraints": { "position": "centre" },
      "components": [
        {
          "id": "defaulticon",
          "type": "imageview",
          "resize": "fit",
          "image": { "type": "symbol", "src": "app" },
          "constraints": { "stretch": "both" }
        },
        {
          "id": "opendefault",
          "type": "button", "text": "",
          "bordered": false,
          "constraints": { "stretch": "both" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/opendefault.sh", "async": true } }]
        }
      ]
    }
  ]
}
