{
  "type": "view",
  "layout": "border",
  "spacing": 8,
  "constraints": { "position": "top", "stretch": "horizontal" },
  "components": [
    {
      "id": "app",
      "type": "view",
      "layout": "inline",
      "direction": "horizontal",
      "spacing": 5,
      "constraints": { "region": "centre", "position": "right" },
      "components": [
        {
          "id": "appicon",
          "type": "imageview",
          "hidden": true,
          "constraints": { "size": 26 },
          "image": { "type": "symbol", "src": "app" }
        },
        { "id": "appname", "type": "label", "text": "", "font": { "size": 14 }, "colour": "secondaryLabelColor", "constraints": { "position": "centre", "insets": { "bottom": 3 } } }
      ]
    },
    {
      "id": "rotate",
      "type": "button", "text": "",
      "bordered": false,
      "font": { "size": 14 },
      "constraints": { "region": "right", "position": "centre", "insets": { "bottom": 3 } },
      "contenttintcolour": "secondaryLabelColor",
      "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/layout.sh", "args": ["toggle"] } }]
    }
  ]
}
