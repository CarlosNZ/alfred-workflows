{
  "id": "customise",
  "type": "view",
  "@collapsed": { "hidden": true },
  "layout": "inline",
  "direction": "horizontal",
  "spacing": "@customiseSpacing",
  "constraints": "@customisePlace",
  "components": [
    {
      "id": "colourbox",
      "type": "view",
      "layout": "stack",
      "constraints": "@buttonBox",
      "components": [
        {
          "id": "colour",
          "type": "button",
          "text": "",
          "bordered": false,
          "constraints": "@swatchBox",
          "font": "@swatchFont",
          "contenttintcolour": "@swatch",
          "image": { "type": "symbol", "src": "circle.fill" },
          "tooltip": "Colour (⌘1–⌘6)",
          "accessibility": { "label": "Colour" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "scripts/picker.sh", "args": ["toggle", "@note", "@form", "colour"] } }]
        }
      ]
    },
    {
      "@needs": "icons",
      "id": "icon",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "image": "@iconImage",
      "tooltip": "Icon (⌘I)",
      "accessibility": { "label": "Icon" },
      "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "scripts/picker.sh", "args": ["toggle", "@note", "@form", "icon"] } }]
    },
    {
      "id": "fontsize",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "image": "@buttonIcon:text-size",
      "tooltip": "Font size (⌘+, ⌘−)",
      "accessibility": { "label": "Font size" },
      "events": [{ "triggers": "actioned", "action": { "type": "json", "src": { "popupmenu": { "src": "fontsize", "menu": "@fontSizeMenu" } } } }]
    }
  ]
}
