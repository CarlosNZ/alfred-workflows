{
  "id": "actions",
  "type": "view",
  "@collapsed": { "hidden": true },
  "layout": "inline",
  "direction": "horizontal",
  "spacing": "@actionsSpacing",
  "constraints": "@actionsPlace",
  "components": [
    {
      "id": "toggle",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "@edit": { "image": "@buttonIcon:eye", "tooltip": "View (⌘E)", "accessibility": { "label": "View" } },
      "@view": { "image": "@buttonIcon:pencil", "tooltip": "Edit (⌘E)", "accessibility": { "label": "Edit" } },
      "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "scripts/window.js", "args": ["toggle", "@note", "@form", "{value:editor.text}"] } }]
    },
    {
      "@form": "quick",
      "id": "stick",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "image": "@buttonIcon:sticky-note-plus",
      "tooltip": "Stick to the desktop (⌘D)",
      "accessibility": { "label": "Make sticky" },
      "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "scripts/window.js", "args": ["stick", "@note", "@form", "{value:editor.text}"] } }]
    }
  ]
}
