{
  "id": "windowbuttons",
  "type": "view",
  "layout": "inline",
  "direction": "horizontal",
  "spacing": "@windowButtonsSpacing",
  "constraints": "@windowButtonsPlace",
  "components": [
    {
      "id": "close",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "image": "@buttonIcon:close",
      "tooltip": "Close (⌘W)",
      "accessibility": { "label": "Close" },
      "events": [{ "triggers": "actioned", "action": { "type": "json", "src": { "finish": {} } } }]
    },
    {
      "id": "collapse",
      "type": "button",
      "text": "",
      "bordered": false,
      "constraints": "@buttonBox",
      "image": "@buttonIcon:arrow-up-to-line",
      "tooltip": "Collapse",
      "accessibility": { "label": "Collapse" },
      "@collapsed": { "image": "@buttonIcon:arrow-down-to-line", "tooltip": "Expand", "accessibility": { "label": "Expand" } },
      "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "scripts/window.js", "args": ["collapse", "@note", "@form", "{value:editor.text}"] } }]
    }
  ]
}
