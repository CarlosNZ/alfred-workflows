{
  "id": "titlestrip",
  "type": "view",
  "layout": "stack",
  "constraints": { "position": "top", "stretch": "horizontal" },
  "components": [{ "id": "titlestripheight", "type": "view", "constraints": "@titleStripBox" }],
  "events": [
    { "triggers": "mousedown", "action": { "type": "json", "src": {} } },
    { "triggers": "doubleclicked", "action": { "type": "script", "src": "scripts/window.js", "args": ["collapse", "@note", "@form", "{value:editor.text}"] } }
  ]
}
