{
  "@sticky": { "iconpath": "@iconPath" },
  "window": {
    "title": "@title",
    "titlevisibility": false,
    "titlebarappearstransparent": true,
    "fullsizecontentview": true,
    "fullscreenable": false,
    "movablebybackground": true,
    "resizeable": true,
    "frameautosave": true,
    "size": { "width": 360, "height": 320 },
    "minsize": { "width": 220, "height": 160 },
    "@quick": { "size": { "width": 640, "height": 400 } },
    "@sticky": { "borderless": true, "cornerradius": 10 },
    "root": {
      "id": "note",
      "type": "view",
      "layout": "stack",
      "@sticky": { "appearance": "light", "background": "@tint" },
      "shortcuts": [
        { "shortcut": "⌘E", "action": { "type": "script", "src": "scripts/window.js", "args": ["toggle", "@note", "@form", "{value:editor.text}"] } },
        { "shortcut": "⌘↩", "action": { "type": "script", "src": "scripts/window.js", "args": ["view", "@note", "@form", "{value:editor.text}"] } },
        { "@form": "quick", "shortcut": "⌘D", "action": { "type": "script", "src": "scripts/window.js", "args": ["stick", "@note", "@form", "{value:editor.text}"] } },
        { "@needs": "icons", "shortcut": "⌘I", "action": { "type": "script", "src": "scripts/picker.sh", "args": ["toggle", "@note", "@form", "icon"] } },
        { "@form": "sticky", "shortcut": "⎋", "action": { "type": "script", "src": "scripts/picker.sh", "args": ["escape", "@note", "@form"] } },
        { "@form": "sticky", "shortcut": "⌘W", "action": { "type": "json", "src": { "finish": {} } } },
        { "shortcut": "⌘⌫", "action": { "type": "script", "src": "scripts/window.js", "args": ["trash", "@note", "@form", "{value:editor.text}"] } },
        { "shortcut": "⌘K", "action": { "type": "script", "src": "scripts/window.js", "args": ["menu", "@note", "@form", "{value:editor.text}"] } },
        "@colourShortcuts",
        "@fontSizeShortcuts"
      ],
      "events": [
        { "triggers": "launched", "action": { "type": "script", "src": "scripts/window.js", "args": ["launched", "@note", "@form", "@mode"] } },
        { "triggers": "quit", "action": { "type": "script", "src": "scripts/window.js", "args": ["quit", "@note", "@form", "{value:editor.text}"] } }
      ],
      "components": [
        { "id": "content" },
        { "@form": "quick", "id": "keyhints" },
        { "id": "menuanchor", "type": "view", "constraints": "@menuAnchorPlace" },
        { "@form": "sticky", "id": "collapsedtitle" },
        { "@form": "sticky", "id": "titlestrip" },
        { "id": "customise" },
        { "id": "actions" },
        { "@form": "sticky", "id": "windowbuttons" },
        { "id": "menubutton" }
      ]
    }
  }
}
