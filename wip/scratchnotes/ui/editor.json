{
  "id": "content",
  "type": "view",
  "layout": "stack",
  "constraints": { "region": "centre", "stretch": "both", "insets": { "left": 14, "right": 10, "bottom": 10 } },
  "components": [
    {
      "id": "editor",
      "type": "textarea",
      "text": "@text",
      "editable": true,
      "disableallsubstitutions": true,
      "focus": true,
      "font": { "size": "@fontSize", "monospaced": true },
      "background": null,
      "constraints": { "stretch": "both" },
      "events": [{ "triggers": "typingstopped", "action": { "type": "script", "src": "scripts/window.js", "args": ["save", "@note", "{value:editor.text}"] } }]
    }
  ]
}
