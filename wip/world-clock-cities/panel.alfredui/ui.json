{
  "variablesconfig": {
    "detail_title": { "src": "variable" }
  },
  "pulse": {
    "src": "./detail.js",
    "interval": 1,
    "intervalmode": "delay",
    "now": true
  },
  "window": {
    "title": "{var:detail_title}",
    "size": { "width": 320, "height": 170 },
    "frameautosave": true,
    "minimisable": false,
    "fullscreenable": false,
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 6,
      "padding": 20,
      "shortcuts": [{ "shortcut": "⎋", "action": { "type": "json", "src": { "finish": {} } } }],
      "components": [
        { "id": "city", "type": "label", "text": " ", "font": { "size": 24, "weight": "bold" } },
        { "id": "country", "type": "label", "text": " ", "font": { "size": 16 }, "colour": "secondaryLabelColor" },
        { "id": "time", "type": "label", "text": " ", "font": { "size": 30, "weight": "light", "monospaced": "digits" } }
      ]
    }
  }
}
