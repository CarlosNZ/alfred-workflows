{
  "type": "view",
  "layout": "border",
  "spacing": 6,
  "components": [
    {
      "type": "view",
      "layout": "stack",
      "constraints": { "region": "centre" },
      "components": [
        {
          "id": "idleicon",
          "type": "imageview",
          "constraints": { "size": 112, "position": "centre" },
          "image": { "type": "symbol", "src": "app" }
        },
        {
          "id": "idletext",
          "type": "label",
          "text": "𝙉𝙤 𝙢𝙚𝙙𝙞𝙖 𝙥𝙡𝙖𝙮𝙞𝙣𝙜",
          "textalign": "centre",
          "font": { "size": 21, "weight": "bold" },
          "accessibility": { "label": "No media playing" },
          "constraints": { "position": "bottom", "insets": { "bottom": 25 } }
        },
        {
          "id": "opendefault",
          "type": "button",
          "text": "",
          "bordered": false,
          "constraints": { "size": 112, "position": "centre" },
          "events": [
            { "triggers": "actioned", "action": { "type": "script", "src": "./scripts/opendefault.sh", "async": true } }
          ]
        }
      ]
    },
    {
      "id": "hint",
      "type": "label",
      "text": "",
      "textalign": "centre",
      "font": { "size": 15 },
      "linebreak": "truncatetail",
      "colour": "secondaryLabelColor",
      "constraints": { "region": "bottom" }
    }
  ]
}
