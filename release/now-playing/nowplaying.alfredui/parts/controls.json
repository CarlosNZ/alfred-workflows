{
  "type": "view",
  "layout": "inline",
  "direction": "vertical",
  "spacing": 14,
  "components": [
    {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 4,
      "components": [
        { "id": "progress", "type": "progress", "style": "linear", "hidden": true },
        {
          "type": "view",
          "layout": "grid",
          "rows": 1,
          "cols": 2,
          "components": [
            { "id": "elapsed", "type": "label", "text": "", "hidden": true, "textalign": "left", "font": { "size": "small", "monospaced": "digits" }, "colour": "secondaryLabelColor" },
            { "id": "duration", "type": "label", "text": "", "hidden": true, "textalign": "right", "font": { "size": "small", "monospaced": "digits" }, "colour": "secondaryLabelColor" }
          ]
        }
      ]
    },
    {
      "type": "view",
      "layout": "grid",
      "rows": 1,
      "cols": 5,
      "spacing": 6,
      "components": [
        {
          "type": "button", "text": "", "font": { "size": 19 }, "constraints": { "size": { "height": 31 } }, "tooltip": "Back 15 seconds",
          "accessibility": { "label": "Back 15 seconds" },
          "image": { "type": "symbol", "src": "gobackward.15" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["back"], "async": true } }]
        },
        {
          "type": "button", "text": "", "font": { "size": 19 }, "constraints": { "size": { "height": 31 } }, "tooltip": "Previous track",
          "accessibility": { "label": "Previous" },
          "image": { "type": "symbol", "src": "backward.fill" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["prev"], "async": true } }]
        },
        {
          "id": "playpause",
          "type": "button", "text": "", "font": { "size": 19 }, "constraints": { "size": { "height": 31 } }, "tooltip": "Play / Pause",
          "accessibility": { "label": "Play or pause" },
          "image": { "type": "symbol", "src": "playpause.fill" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["playpause"], "async": true } }]
        },
        {
          "type": "button", "text": "", "font": { "size": 19 }, "constraints": { "size": { "height": 31 } }, "tooltip": "Next track",
          "accessibility": { "label": "Next" },
          "image": { "type": "symbol", "src": "forward.fill" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["next"], "async": true } }]
        },
        {
          "type": "button", "text": "", "font": { "size": 19 }, "constraints": { "size": { "height": 31 } }, "tooltip": "Forward 15 seconds",
          "accessibility": { "label": "Forward 15 seconds" },
          "image": { "type": "symbol", "src": "goforward.15" },
          "events": [{ "triggers": "actioned", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["forward"], "async": true } }]
        }
      ]
    }
  ]
}
