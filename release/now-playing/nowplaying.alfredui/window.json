{
  "title": "Now Playing",
  "titlevisibility": false,
  "titlebarappearstransparent": true,
  "fullsizecontentview": true,
  "minimisable": false,
  "fullscreenable": false,
  "movablebybackground": true,
  "blur": true,
  "appearance": "dark",
  "size": { "width": 340, "height": 540 },
  "minsize": { "width": 280, "height": 240 },
  "resizeable": true,
  "frameautosave": true,
  "root": {
    "id": "panel",
    "type": "view",
    "layout": "stack",
    "padding": 16,
    "background": "rgb(18, 18, 20, 0.55)",
    "shortcuts": [
      { "shortcut": "⎋", "action": { "type": "json", "src": { "finish": {} } } },
      { "shortcut": "␣", "action": { "type": "script", "src": "./scripts/control.sh", "args": ["playpause"], "async": true } }
    ],
    "components": [
      { "id": "content" },
      { "id": "toprow" }
    ]
  }
}
